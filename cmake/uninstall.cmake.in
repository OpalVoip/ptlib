# Remove the files recorded by the last cmake --install of this build tree.
if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR
    "Cannot find @CMAKE_BINARY_DIR@/install_manifest.txt\n"
    "cmake --install has not been run for this build tree.")
endif()

cmake_path(SET _prefix NORMALIZE "@CMAKE_INSTALL_PREFIX@")
file(STRINGS "@CMAKE_BINARY_DIR@/install_manifest.txt" _files)
set(_dirs "")
foreach(_file IN LISTS _files)
  if(_file STREQUAL "")
    continue()
  endif()
  set(_path "$ENV{DESTDIR}${_file}")
  if(IS_SYMLINK "${_path}" OR EXISTS "${_path}")
    message(STATUS "Uninstalling ${_path}")
    file(REMOVE "${_path}")
    if(EXISTS "${_path}")
      message(FATAL_ERROR "Could not remove ${_path}")
    endif()
  else()
    message(STATUS "Already gone: ${_path}")
  endif()

  cmake_path(SET _dir NORMALIZE "${_file}")
  while(TRUE)
    cmake_path(GET _dir PARENT_PATH _dir)
    if(_dir STREQUAL "")
      break()
    endif()
    cmake_path(COMPARE "${_dir}" EQUAL "${_prefix}" _at_prefix)
    if(_at_prefix)
      break()
    endif()
    list(APPEND _dirs "${_dir}")
  endwhile()
endforeach()

if(_dirs)
  list(REMOVE_DUPLICATES _dirs)
  list(SORT _dirs ORDER DESCENDING)
endif()
foreach(_dir IN LISTS _dirs)
  set(_path "$ENV{DESTDIR}${_dir}")
  if(IS_DIRECTORY "${_path}")
    file(GLOB _contents LIST_DIRECTORIES true "${_path}/*" "${_path}/.[!.]*")
    if(_contents STREQUAL "")
      file(REMOVE_RECURSE "${_path}")
    endif()
  endif()
endforeach()
