# Adds the "debug" and "both" build targets.
#
# Single-config generators keep this tree as Release (or whatever
# CMAKE_BUILD_TYPE the user set) and configure a second tree at
# ${CMAKE_BINARY_DIR}/debug with CMAKE_BUILD_TYPE=Debug.
# Multi-config generators build the Debug and Release configurations
# of this tree.

if(PTLIB_SECONDARY_BUILD)
  return()
endif()

cmake_host_system_information(RESULT _ptlib_jobs QUERY NUMBER_OF_LOGICAL_CORES)
if(DEFINED ENV{CMAKE_BUILD_PARALLEL_LEVEL} AND NOT "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}" STREQUAL "")
  set(_ptlib_jobs "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
endif()

get_property(_ptlib_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)

if(_ptlib_multi_config)
  add_custom_target(debug
    COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config Debug --parallel "${_ptlib_jobs}"
    USES_TERMINAL
    VERBATIM
    COMMENT "Building Debug PTLib")
  add_custom_target(both
    COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config Release --parallel "${_ptlib_jobs}"
    COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}"
            --config Debug --parallel "${_ptlib_jobs}"
    USES_TERMINAL
    VERBATIM
    COMMENT "Building Release and Debug PTLib")
  return()
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug")
  message(STATUS "PTLib: this tree is Debug; the debug and both targets are not added")
  return()
endif()

set(_ptlib_debug_dir "${CMAKE_BINARY_DIR}/debug")
set(_ptlib_debug_cache "${CMAKE_BINARY_DIR}/ptlib-debug-cache.cmake")

set(_ptlib_forward_names
  CMAKE_TOOLCHAIN_FILE
  CMAKE_INSTALL_PREFIX
  CMAKE_PREFIX_PATH
  CMAKE_FIND_ROOT_PATH
  CMAKE_SYSROOT
  CMAKE_OSX_ARCHITECTURES
  CMAKE_OSX_DEPLOYMENT_TARGET
  CMAKE_OSX_SYSROOT
  CMAKE_C_COMPILER
  CMAKE_CXX_COMPILER
  CMAKE_OBJCXX_COMPILER
  CMAKE_C_COMPILER_LAUNCHER
  CMAKE_CXX_COMPILER_LAUNCHER
  CMAKE_OBJCXX_COMPILER_LAUNCHER
  CMAKE_C_FLAGS
  CMAKE_CXX_FLAGS
  CMAKE_OBJCXX_FLAGS
  CMAKE_EXE_LINKER_FLAGS
  CMAKE_SHARED_LINKER_FLAGS
  CMAKE_MODULE_LINKER_FLAGS
  CMAKE_MAKE_PROGRAM
  VCPKG_TARGET_TRIPLET
  VCPKG_HOST_TRIPLET
  VCPKG_CHAINLOAD_TOOLCHAIN_FILE
  VCPKG_MANIFEST_FEATURES)

get_cmake_property(_ptlib_cache_vars CACHE_VARIABLES)
foreach(_name IN LISTS _ptlib_cache_vars)
  if(_name MATCHES "^PTLIB_")
    get_property(_type CACHE ${_name} PROPERTY TYPE)
    if(_type STREQUAL "BOOL" OR _type STREQUAL "STRING")
      list(APPEND _ptlib_forward_names "${_name}")
    endif()
  endif()
endforeach()

set(_ptlib_script "# Generated by PTLib. Forwards options into the debug build tree.\n")
string(APPEND _ptlib_script
  "set(BUILD_SHARED_LIBS \"${BUILD_SHARED_LIBS}\" CACHE BOOL \"\" FORCE)\n")

foreach(_name IN LISTS _ptlib_forward_names)
  if(NOT DEFINED CACHE{${_name}})
    continue()
  endif()
  get_property(_val CACHE ${_name} PROPERTY VALUE)
  get_property(_type CACHE ${_name} PROPERTY TYPE)
  if(_val STREQUAL "" OR _type STREQUAL "INTERNAL" OR _type STREQUAL "STATIC")
    continue()
  endif()
  string(REPLACE "\\" "\\\\" _val "${_val}")
  string(REPLACE "\"" "\\\"" _val "${_val}")
  string(REPLACE "\$" "\\\$" _val "${_val}")
  string(APPEND _ptlib_script
    "set(${_name} \"${_val}\" CACHE ${_type} \"\" FORCE)\n")
endforeach()
file(WRITE "${_ptlib_debug_cache}" "${_ptlib_script}")

set(_ptlib_configure
  "${CMAKE_COMMAND}"
  -G "${CMAKE_GENERATOR}"
  -S "${CMAKE_SOURCE_DIR}"
  -B "${_ptlib_debug_dir}"
  -C "${_ptlib_debug_cache}"
  -DPTLIB_SECONDARY_BUILD=ON
  -DCMAKE_BUILD_TYPE=Debug)
if(CMAKE_GENERATOR_PLATFORM)
  list(APPEND _ptlib_configure -A "${CMAKE_GENERATOR_PLATFORM}")
endif()
if(CMAKE_GENERATOR_TOOLSET)
  list(APPEND _ptlib_configure -T "${CMAKE_GENERATOR_TOOLSET}")
endif()

add_custom_target(debug
  COMMAND ${_ptlib_configure}
  COMMAND "${CMAKE_COMMAND}" --build "${_ptlib_debug_dir}" --parallel "${_ptlib_jobs}"
  USES_TERMINAL
  VERBATIM
  COMMENT "Configuring and building Debug PTLib in ${_ptlib_debug_dir}")

# "both" builds the same targets as the default "all" target, plus debug.
# Depending on them here uses this build's job pool. A nested cmake --build of
# this same directory would re-enter the generator.
function(ptlib_collect_targets dir out_var)
  get_property(_targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(_subdir IN LISTS _subdirs)
    ptlib_collect_targets("${_subdir}" _sub_targets)
    list(APPEND _targets ${_sub_targets})
  endforeach()
  set(${out_var} "${_targets}" PARENT_SCOPE)
endfunction()

ptlib_collect_targets("${CMAKE_SOURCE_DIR}" _ptlib_all_targets)
set(_ptlib_release_targets "")
foreach(_target IN LISTS _ptlib_all_targets)
  get_target_property(_excluded "${_target}" EXCLUDE_FROM_ALL)
  if(_excluded)
    continue()
  endif()
  list(APPEND _ptlib_release_targets "${_target}")
endforeach()

add_custom_target(both
  DEPENDS ${_ptlib_release_targets} debug
  COMMENT "Building Release and Debug PTLib")

set_property(DIRECTORY APPEND PROPERTY ADDITIONAL_CLEAN_FILES "${_ptlib_debug_dir}")

message(STATUS "PTLib default target: ${CMAKE_BUILD_TYPE}. Also available: debug, both")
