function(ptlib_wants feature out)
  set(mode "${PTLIB_${feature}}")
  if(mode STREQUAL "OFF" OR mode STREQUAL "FALSE" OR mode STREQUAL "0")
    set(${out} FALSE PARENT_SCOPE)
  else()
    set(${out} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(ptlib_require feature found)
  set(mode "${PTLIB_${feature}}")
  set(enabled FALSE)
  if(mode STREQUAL "ON" OR mode STREQUAL "TRUE" OR mode STREQUAL "1")
    if(NOT ${found})
      message(FATAL_ERROR "PTLIB_${feature} is ON but its library was not found")
    endif()
    set(enabled TRUE)
  elseif(NOT mode STREQUAL "OFF" AND NOT mode STREQUAL "FALSE" AND NOT mode STREQUAL "0")
    if(${found})
      set(enabled TRUE)
    else()
      message(STATUS "PTLIB_${feature} not found; disabling")
    endif()
  endif()
  set(PTLIB_${feature}_ENABLED ${enabled} PARENT_SCOPE)
endfunction()

find_package(PkgConfig QUIET)

# CMake package names recorded here are emitted as find_dependency() calls
# for consumers. vcpkg and Homebrew config packages use this path; pkg-config
# remains the fallback when a port has no CMake package.
function(ptlib_note_dependency call)
  get_property(_calls GLOBAL PROPERTY PTLIB_CMAKE_DEPENDENCY_CALLS)
  set(_line "find_dependency(${call})")
  if(NOT _line IN_LIST _calls)
    list(APPEND _calls "${_line}")
  endif()
  set_property(GLOBAL PROPERTY PTLIB_CMAKE_DEPENDENCY_CALLS "${_calls}")
endfunction()

function(ptlib_note_snippet code)
  get_property(_snippets GLOBAL PROPERTY PTLIB_CMAKE_EXTRA_SNIPPETS)
  if(NOT code IN_LIST _snippets)
    list(APPEND _snippets "${code}")
  endif()
  set_property(GLOBAL PROPERTY PTLIB_CMAKE_EXTRA_SNIPPETS "${_snippets}")
endfunction()

