function(ptlib_feature name doc default)
  if(ARGC GREATER 3)
    cmake_dependent_option(PTLIB_${name} "${doc}" "${default}" "${ARGV3}" OFF)
  else()
    option(PTLIB_${name} "${doc}" "${default}")
  endif()
endfunction()

