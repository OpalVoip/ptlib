# vcpkg's ffmpeg port exposes a FindFFMPEG module (variables and, when the
# module creates them, FFmpeg:: imported targets). Config packages that
# already provide those targets are accepted first.
function(ptlib_probe_ffmpeg)
  ptlib_wants(FFMPEG _want)
  if(NOT _want OR PTLIB_FFMPEG_FOUND)
    return()
  endif()
  set(_targets FFmpeg::avcodec FFmpeg::avutil FFmpeg::avformat FFmpeg::swscale FFmpeg::swresample)
  find_package(FFMPEG CONFIG QUIET)
  set(_have_targets TRUE)
  foreach(_tgt IN LISTS _targets)
    if(NOT TARGET "${_tgt}")
      set(_have_targets FALSE)
    endif()
  endforeach()
  if(NOT _have_targets)
    find_package(FFMPEG QUIET)
    set(_have_targets TRUE)
    foreach(_tgt IN LISTS _targets)
      if(NOT TARGET "${_tgt}")
        set(_have_targets FALSE)
      endif()
    endforeach()
  endif()
  if(_have_targets)
    set(PTLIB_FFMPEG_FOUND TRUE PARENT_SCOPE)
    set(PTLIB_FFMPEG_LINK ${_targets} PARENT_SCOPE)
    ptlib_note_dependency(FFMPEG)
    return()
  endif()
  if(FFMPEG_FOUND AND FFMPEG_LIBRARIES AND FFMPEG_INCLUDE_DIRS)
    if(NOT TARGET PTLib_ffmpeg)
      add_library(PTLib_ffmpeg INTERFACE)
      target_include_directories(PTLib_ffmpeg INTERFACE ${FFMPEG_INCLUDE_DIRS})
      target_link_libraries(PTLib_ffmpeg INTERFACE ${FFMPEG_LIBRARIES})
      if(FFMPEG_LIBRARY_DIRS)
        target_link_directories(PTLib_ffmpeg INTERFACE ${FFMPEG_LIBRARY_DIRS})
      endif()
    endif()
    set(PTLIB_FFMPEG_FOUND TRUE PARENT_SCOPE)
    set(PTLIB_FFMPEG_LINK PTLib_ffmpeg PARENT_SCOPE)
  endif()
endfunction()
ptlib_probe_ffmpeg()
ptlib_pkg_probe(FFMPEG libavcodec libavutil libavformat libswscale libswresample)

# Windows shared imports need IMPORTED_IMPLIB. Homebrew's macOS SDL2 config
# is a dylib, and CMake refuses to generate a WIN32 build that links it.
function(ptlib_imported_target_usable target out_var)
  set(_ok TRUE)
  if(WIN32 AND TARGET "${target}")
    get_target_property(_type "${target}" TYPE)
    if(_type STREQUAL "SHARED_LIBRARY")
      set(_implib "")
      get_target_property(_candidate "${target}" IMPORTED_IMPLIB)
      if(_candidate)
        set(_implib "${_candidate}")
      endif()
      if(NOT _implib AND CMAKE_BUILD_TYPE)
        string(TOUPPER "${CMAKE_BUILD_TYPE}" _cfg)
        get_target_property(_candidate "${target}" "IMPORTED_IMPLIB_${_cfg}")
        if(_candidate)
          set(_implib "${_candidate}")
        endif()
      endif()
      if(NOT _implib)
        get_target_property(_cfgs "${target}" IMPORTED_CONFIGURATIONS)
        if(_cfgs)
          foreach(_cfg IN LISTS _cfgs)
            get_target_property(_candidate "${target}" "IMPORTED_IMPLIB_${_cfg}")
            if(_candidate)
              set(_implib "${_candidate}")
              break()
            endif()
          endforeach()
        endif()
      endif()
      if(NOT _implib)
        set(_ok FALSE)
      endif()
    endif()
    if(_ok AND NOT _type STREQUAL "INTERFACE_LIBRARY")
      set(_loc "")
      if(CMAKE_BUILD_TYPE)
        string(TOUPPER "${CMAKE_BUILD_TYPE}" _cfg)
        get_target_property(_candidate "${target}" "IMPORTED_LOCATION_${_cfg}")
        if(_candidate)
          set(_loc "${_candidate}")
        endif()
      endif()
      if(NOT _loc)
        get_target_property(_candidate "${target}" IMPORTED_LOCATION)
        if(_candidate)
          set(_loc "${_candidate}")
        endif()
      endif()
      if(_loc MATCHES "\\.(dylib|so)(\\.[0-9.]+)?$")
        set(_ok FALSE)
      endif()
    endif()
  endif()
  set(${out_var} ${_ok} PARENT_SCOPE)
endfunction()

function(ptlib_probe_sdl)
  ptlib_wants(SDL _want)
  if(NOT _want OR PTLIB_SDL_FOUND)
    return()
  endif()
  find_package(SDL2 CONFIG QUIET)
  set(_sdl "")
  if(TARGET SDL2::SDL2)
    ptlib_imported_target_usable(SDL2::SDL2 _sdl_ok)
    if(_sdl_ok)
      set(_sdl SDL2::SDL2)
    endif()
  endif()
  if(NOT _sdl AND TARGET SDL2::SDL2-static)
    ptlib_imported_target_usable(SDL2::SDL2-static _sdl_ok)
    if(_sdl_ok)
      set(_sdl SDL2::SDL2-static)
    endif()
  endif()
  if(NOT _sdl)
    if(TARGET SDL2::SDL2 OR TARGET SDL2::SDL2-static)
      message(STATUS "SDL2: ignoring host CMake package; not a Windows library")
    endif()
    return()
  endif()
  if(WIN32 AND TARGET SDL2::SDL2main)
    ptlib_imported_target_usable(SDL2::SDL2main _main_ok)
    if(_main_ok)
      list(APPEND _sdl SDL2::SDL2main)
    endif()
  endif()
  set(PTLIB_SDL_FOUND TRUE PARENT_SCOPE)
  set(PTLIB_SDL_LINK ${_sdl} PARENT_SCOPE)
  ptlib_note_dependency(SDL2)
endfunction()
ptlib_probe_sdl()
