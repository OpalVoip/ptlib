# Homebrew's libpcap is keg-only (macOS already ships one), so libpcap.pc is
# not on the default PKG_CONFIG_PATH. Prefer pkg-config, then find_path /
# find_library, preferring a Homebrew keg when present.
ptlib_wants(PCAP _want_pcap)
set(PTLIB_PCAP_FOUND FALSE)
set(PTLIB_PCAP_INCLUDE "")
if(_want_pcap AND PKG_CONFIG_FOUND)
  pkg_check_modules(PTLIB_PC_PCAP IMPORTED_TARGET libpcap)
  if(PTLIB_PC_PCAP_FOUND)
    set(PTLIB_PCAP_FOUND TRUE)
    set(PTLIB_PCAP_LINK PkgConfig::PTLIB_PC_PCAP)
    ptlib_note_snippet(
      "pkg_check_modules(PTLIB_PC_PCAP REQUIRED IMPORTED_TARGET libpcap)")
  endif()
endif()
if(_want_pcap AND NOT PTLIB_PCAP_FOUND)
  set(_ptlib_pcap_hints "")
  foreach(_prefix IN ITEMS /opt/homebrew/opt/libpcap /usr/local/opt/libpcap)
    if(EXISTS "${_prefix}")
      list(APPEND _ptlib_pcap_hints "${_prefix}")
    endif()
  endforeach()
  find_path(PTLIB_PCAP_INCLUDE_DIR NAMES pcap/pcap.h pcap.h
    HINTS ${_ptlib_pcap_hints} PATH_SUFFIXES include)
  find_library(PTLIB_PCAP_LIBRARY NAMES pcap
    HINTS ${_ptlib_pcap_hints} PATH_SUFFIXES lib)
  if(PTLIB_PCAP_INCLUDE_DIR AND PTLIB_PCAP_LIBRARY)
    set(PTLIB_PCAP_FOUND TRUE)
    set(PTLIB_PCAP_INCLUDE "${PTLIB_PCAP_INCLUDE_DIR}")
    set(PTLIB_PCAP_LINK "${PTLIB_PCAP_LIBRARY}")
    message(STATUS "PCAP: found ${PTLIB_PCAP_LIBRARY} (no pkg-config module)")
  endif()
  unset(_ptlib_pcap_hints)
endif()
ptlib_require(PCAP PTLIB_PCAP_FOUND)

# vcpkg's ffmpeg port ships FindFFMPEG.cmake (variables only; no FFmpeg::
# targets). Config packages that already provide those targets are preferred.
# The variable fallback must be INTERFACE IMPORTED: a plain INTERFACE library
# cannot carry build/vcpkg_installed paths (CMake rejects them on export).
function(ptlib_probe_ffmpeg)
  ptlib_wants(FFMPEG _want)
  if(NOT _want OR PTLIB_FFMPEG_FOUND)
    return()
  endif()
  set(_targets FFmpeg::avcodec FFmpeg::avutil FFmpeg::avformat FFmpeg::swscale FFmpeg::swresample)
  find_package(FFMPEG CONFIG QUIET)
  set(_have_targets TRUE)
  foreach(_tgt IN LISTS _targets)
    if(NOT TARGET "${_tgt}")
      set(_have_targets FALSE)
    endif()
  endforeach()
  if(NOT _have_targets)
    find_package(FFMPEG QUIET)
    set(_have_targets TRUE)
    foreach(_tgt IN LISTS _targets)
      if(NOT TARGET "${_tgt}")
        set(_have_targets FALSE)
      endif()
    endforeach()
  endif()
  if(_have_targets)
    set(PTLIB_FFMPEG_FOUND TRUE PARENT_SCOPE)
    set(PTLIB_FFMPEG_LINK ${_targets} PARENT_SCOPE)
    ptlib_note_dependency(FFMPEG)
    return()
  endif()
  if(FFMPEG_FOUND AND FFMPEG_LIBRARIES AND FFMPEG_INCLUDE_DIRS)
    if(NOT TARGET PTLib_ffmpeg)
      add_library(PTLib_ffmpeg INTERFACE IMPORTED GLOBAL)
      set_target_properties(PTLib_ffmpeg PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${FFMPEG_INCLUDE_DIRS}")
      # FindFFMPEG uses optimized/debug keywords; those are only valid through
      # target_link_libraries, which turns them into generator expressions.
      target_link_libraries(PTLib_ffmpeg INTERFACE ${FFMPEG_LIBRARIES})
    endif()
    set(PTLIB_FFMPEG_FOUND TRUE PARENT_SCOPE)
    set(PTLIB_FFMPEG_LINK PTLib_ffmpeg PARENT_SCOPE)
    ptlib_note_dependency(FFMPEG)
  endif()
endfunction()
ptlib_probe_ffmpeg()
ptlib_pkg_probe(FFMPEG libavcodec libavutil libavformat libswscale libswresample)

# Windows shared imports need IMPORTED_IMPLIB. Homebrew's macOS SDL2 config
# is a dylib, and CMake refuses to generate a WIN32 build that links it.
function(ptlib_imported_target_usable target out_var)
  set(_ok TRUE)
  if(WIN32 AND TARGET "${target}")
    get_target_property(_type "${target}" TYPE)
    if(_type STREQUAL "SHARED_LIBRARY")
      set(_implib "")
      get_target_property(_candidate "${target}" IMPORTED_IMPLIB)
      if(_candidate)
        set(_implib "${_candidate}")
      endif()
      if(NOT _implib AND CMAKE_BUILD_TYPE)
        string(TOUPPER "${CMAKE_BUILD_TYPE}" _cfg)
        get_target_property(_candidate "${target}" "IMPORTED_IMPLIB_${_cfg}")
        if(_candidate)
          set(_implib "${_candidate}")
        endif()
      endif()
      if(NOT _implib)
        get_target_property(_cfgs "${target}" IMPORTED_CONFIGURATIONS)
        if(_cfgs)
          foreach(_cfg IN LISTS _cfgs)
            get_target_property(_candidate "${target}" "IMPORTED_IMPLIB_${_cfg}")
            if(_candidate)
              set(_implib "${_candidate}")
              break()
            endif()
          endforeach()
        endif()
      endif()
      if(NOT _implib)
        set(_ok FALSE)
      endif()
    endif()
    if(_ok AND NOT _type STREQUAL "INTERFACE_LIBRARY")
      set(_loc "")
      if(CMAKE_BUILD_TYPE)
        string(TOUPPER "${CMAKE_BUILD_TYPE}" _cfg)
        get_target_property(_candidate "${target}" "IMPORTED_LOCATION_${_cfg}")
        if(_candidate)
          set(_loc "${_candidate}")
        endif()
      endif()
      if(NOT _loc)
        get_target_property(_candidate "${target}" IMPORTED_LOCATION)
        if(_candidate)
          set(_loc "${_candidate}")
        endif()
      endif()
      if(_loc MATCHES "\\.(dylib|so)(\\.[0-9.]+)?$")
        set(_ok FALSE)
      endif()
    endif()
  endif()
  set(${out_var} ${_ok} PARENT_SCOPE)
endfunction()

function(ptlib_probe_sdl)
  ptlib_wants(SDL _want)
  if(NOT _want OR PTLIB_SDL_FOUND)
    return()
  endif()
  find_package(SDL2 CONFIG QUIET)
  set(_sdl "")
  if(TARGET SDL2::SDL2)
    ptlib_imported_target_usable(SDL2::SDL2 _sdl_ok)
    if(_sdl_ok)
      set(_sdl SDL2::SDL2)
    endif()
  endif()
  if(NOT _sdl AND TARGET SDL2::SDL2-static)
    ptlib_imported_target_usable(SDL2::SDL2-static _sdl_ok)
    if(_sdl_ok)
      set(_sdl SDL2::SDL2-static)
    endif()
  endif()
  if(NOT _sdl)
    if(TARGET SDL2::SDL2 OR TARGET SDL2::SDL2-static)
      message(STATUS "SDL2: ignoring host CMake package; not a Windows library")
    endif()
    return()
  endif()
  # Do not link SDL2main. It supplies WinMain/SDL_main for SDL apps; PTLib
  # (and OPAL samples) already have their own entry point, so pulling it in
  # via PUBLIC ptlib deps causes LNK2005/LNK2019 on Windows console targets.
  set(PTLIB_SDL_FOUND TRUE PARENT_SCOPE)
  set(PTLIB_SDL_LINK ${_sdl} PARENT_SCOPE)
  ptlib_note_dependency(SDL2)
endfunction()
