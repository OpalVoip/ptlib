    set(PTLIB_CURSES_LINK ${CURSES_LIBRARIES})
    ptlib_note_dependency(Curses)
  endif()
endif()
ptlib_require(CURSES PTLIB_CURSES_FOUND)

# DNS resolver is libc or libresolv, not a pkg-config module.
ptlib_wants(RESOLVER _want_resolver)
set(PTLIB_RESOLVER_FOUND FALSE)
set(PTLIB_RESOLVER_LINK "")
if(_want_resolver AND NOT WIN32)
  cmake_push_check_state(RESET)
  set(CMAKE_REQUIRED_LIBRARIES resolv)
  check_c_source_compiles("
#include <netinet/in.h>
#include <resolv.h>
int main(void) { struct __res_state state; return res_ninit(&state); }
" PTLIB_RES_NINIT_RESOLV)
  if(PTLIB_RES_NINIT_RESOLV)
    set(PTLIB_RESOLVER_FOUND TRUE)
    set(PTLIB_RESOLVER_LINK resolv)
  else()
    set(CMAKE_REQUIRED_LIBRARIES)
    check_c_source_compiles("
#include <netinet/in.h>
#include <resolv.h>
int main(void) { struct __res_state state; return res_ninit(&state); }
" PTLIB_RES_NINIT_LIBC)
    if(PTLIB_RES_NINIT_LIBC)
      set(PTLIB_RESOLVER_FOUND TRUE)
    endif()
  endif()
  cmake_pop_check_state()
elseif(_want_resolver AND WIN32)
  set(PTLIB_RESOLVER_FOUND TRUE)
endif()
ptlib_require(RESOLVER PTLIB_RESOLVER_FOUND)

ptlib_wants(BACKTRACE _want_bt)
set(PTLIB_BACKTRACE_FOUND FALSE)
if(_want_bt AND PTLIB_HAS_BACKTRACE_SYM)
  set(PTLIB_BACKTRACE_FOUND TRUE)
endif()
ptlib_require(BACKTRACE PTLIB_BACKTRACE_FOUND)

if(PTLIB_IPV6)
  if(NOT PTLIB_HOST_HAS_IPV6)
    message(FATAL_ERROR "PTLIB_IPV6 is ON but sockaddr_in6 is not available")
  endif()
  ptlib_define(P_HAS_IPV6 1)
endif()

if(NOT PTLIB_INTERNAL_REGEX)
  check_symbol_exists(regcomp regex.h PTLIB_HAS_REGCOMP)
endif()
if(PTLIB_HAS_REGCOMP AND NOT PTLIB_INTERNAL_REGEX)
  ptlib_define(P_REGEX 1)
  set(PTLIB_USE_SYSTEM_REGEX TRUE)
else()
  set(PTLIB_USE_SYSTEM_REGEX FALSE)
endif()

if(PTLIB_BACKTRACE_ENABLED)
  ptlib_define(P_HAS_BACKTRACE 1)
  if(PTLIB_HAVE_CXXABI_H)
    ptlib_define(P_HAS_DEMANGLE 1)
  endif()
endif()

if(PTLIB_RESOLVER_ENABLED)
  ptlib_define(P_DNS_RESOLVER 1)
  ptlib_define(P_HAS_RES_NINIT 1)
endif()

# OpenLDAP is only useful with a resolver, matching configure.ac.
if(PTLIB_OPENLDAP_ENABLED AND NOT PTLIB_RESOLVER_ENABLED)
  message(STATUS "OpenLDAP disabled because the DNS resolver is disabled")
  set(PTLIB_OPENLDAP_ENABLED FALSE)
endif()

# Plugins that need a host header or library.
set(PTLIB_ALSA_ENABLED FALSE)
set(PTLIB_OSS_ENABLED FALSE)
set(PTLIB_PULSE_ENABLED FALSE)
set(PTLIB_V4L2_ENABLED FALSE)
set(PTLIB_BSDVIDEO_ENABLED FALSE)

if(PTLIB_PLUGINS AND NOT PTLIB_PLATFORM_SOURCES STREQUAL "msos")
  if(PTLIB_AUDIO AND PTLIB_OS_TAG STREQUAL "P_LINUX")
    ptlib_wants(ALSA _want_alsa)
    if(_want_alsa)
      find_library(PTLIB_ALSA_LIBRARY asound)
      find_path(PTLIB_ALSA_INCLUDE alsa/asoundlib.h)
      if(PTLIB_ALSA_LIBRARY AND PTLIB_ALSA_INCLUDE)
        set(PTLIB_ALSA_FOUND TRUE)
      else()
        set(PTLIB_ALSA_FOUND FALSE)
      endif()
      ptlib_require(ALSA PTLIB_ALSA_FOUND)
    endif()
  endif()

  if(PTLIB_AUDIO AND (PTLIB_OS_TAG STREQUAL "P_LINUX" OR PTLIB_IS_BSD))
    ptlib_wants(OSS _want_oss)
    if(_want_oss)
      check_include_files("sys/soundcard.h" PTLIB_HAVE_SOUNDCARD_H)
      if(NOT PTLIB_HAVE_SOUNDCARD_H)
        check_include_files("linux/soundcard.h" PTLIB_HAVE_LINUX_SOUNDCARD_H)
      endif()
      if(PTLIB_HAVE_SOUNDCARD_H OR PTLIB_HAVE_LINUX_SOUNDCARD_H)
        set(PTLIB_OSS_FOUND TRUE)
      else()
        set(PTLIB_OSS_FOUND FALSE)
      endif()
      ptlib_require(OSS PTLIB_OSS_FOUND)
    endif()
  endif()

  if(PTLIB_AUDIO)
    ptlib_pkg_probe(PULSE libpulse libpulse-simple)
  endif()

  if(PTLIB_VIDEO AND PTLIB_OS_TAG STREQUAL "P_LINUX")
    ptlib_wants(V4L2 _want_v4l2)
    if(_want_v4l2)
      check_include_files("linux/videodev2.h" PTLIB_HAVE_VIDEODEV2_H)
      if(NOT PTLIB_HAVE_VIDEODEV2_H)
        check_include_files("sys/videoio.h" PTLIB_HAVE_VIDEOIO_H)
      endif()
      if(PTLIB_HAVE_VIDEODEV2_H OR PTLIB_HAVE_VIDEOIO_H)
        set(PTLIB_V4L2_FOUND TRUE)
      else()
        set(PTLIB_V4L2_FOUND FALSE)
      endif()
      ptlib_require(V4L2 PTLIB_V4L2_FOUND)
    endif()
  endif()

  if(PTLIB_VIDEO AND PTLIB_IS_BSD)
    set(PTLIB_BSDVIDEO_ENABLED TRUE)
  endif()
endif()

