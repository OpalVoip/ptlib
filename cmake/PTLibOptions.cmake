# Mach-O archives from a macOS `ar` are reported as "random library". MinGW
# import libraries are plain "current ar archive" and can be linked.
function(ptlib_is_host_binary path result)
  set(${result} FALSE PARENT_SCOPE)
  if(NOT WIN32 OR NOT path OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    return()
  endif()
  if(path MATCHES "\\.(dylib|so)(\\.[0-9.]+)?$")
    set(${result} TRUE PARENT_SCOPE)
    return()
  endif()
  find_program(PTLIB_FILE_COMMAND file)
  if(NOT PTLIB_FILE_COMMAND)
    return()
  endif()
  execute_process(
    COMMAND "${PTLIB_FILE_COMMAND}" -b "${path}"
    OUTPUT_VARIABLE _kind
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
  if(_kind MATCHES "Mach-O|random library")
    set(${result} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(ptlib_link_is_windows items result)
  set(_ok TRUE)
  if(WIN32)
    foreach(_item IN LISTS ${items})
      set(_files "")
      if(_item MATCHES "^\\$<LINK_ONLY:(.+)>$")
        set(_item "${CMAKE_MATCH_1}")
      endif()
      if(TARGET "${_item}")
        foreach(_prop IN ITEMS IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_DEBUG)
          get_target_property(_loc "${_item}" "${_prop}")
          if(_loc)
            list(APPEND _files "${_loc}")
          endif()
        endforeach()
        get_target_property(_iface "${_item}" INTERFACE_LINK_LIBRARIES)
        if(_iface)
          foreach(_dep IN LISTS _iface)
            if(_dep MATCHES "^\\$<LINK_ONLY:(.+)>$")
              set(_dep "${CMAKE_MATCH_1}")
            endif()
            if(EXISTS "${_dep}" AND NOT IS_DIRECTORY "${_dep}")
              list(APPEND _files "${_dep}")
            elseif(TARGET "${_dep}")
              foreach(_prop IN ITEMS IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_DEBUG)
                get_target_property(_loc "${_dep}" "${_prop}")
                if(_loc)
                  list(APPEND _files "${_loc}")
                endif()
              endforeach()
            endif()
          endforeach()
        endif()
      elseif(EXISTS "${_item}" AND NOT IS_DIRECTORY "${_item}")
        list(APPEND _files "${_item}")
      endif()
      foreach(_file IN LISTS _files)
        ptlib_is_host_binary("${_file}" _host)
        if(_host)
          set(_ok FALSE)
        endif()
      endforeach()
    endforeach()
  endif()
  set(${result} ${_ok} PARENT_SCOPE)
endfunction()

macro(ptlib_pkg_probe feature)
  ptlib_wants(${feature} _want)
  if(NOT DEFINED PTLIB_${feature}_FOUND)
    set(PTLIB_${feature}_FOUND FALSE)
  endif()
  if(_want AND NOT PTLIB_${feature}_FOUND AND PKG_CONFIG_FOUND)
    pkg_check_modules(PTLIB_PC_${feature} IMPORTED_TARGET ${ARGN})
    set(_pc_ok ${PTLIB_PC_${feature}_FOUND})
    if(_pc_ok AND WIN32)
      # A macOS Homebrew .pc (for example sdl2's -framework Cocoa, or a
      # Mach-O .a) is not a MinGW library.
      if("${PTLIB_PC_${feature}_LDFLAGS}" MATCHES "-framework")
        set(_pc_ok FALSE)
      endif()
      set(_pc_items PkgConfig::PTLIB_PC_${feature})
      foreach(_lib IN LISTS PTLIB_PC_${feature}_LINK_LIBRARIES PTLIB_PC_${feature}_LIBRARIES)
        list(APPEND _pc_items "${_lib}")
        if(_lib MATCHES "\\.(dylib|so)(\\.[0-9.]+)?$")
          set(_pc_ok FALSE)
        endif()
      endforeach()
      foreach(_dir IN LISTS PTLIB_PC_${feature}_LIBRARY_DIRS)
        foreach(_name IN LISTS PTLIB_PC_${feature}_LIBRARIES)
          foreach(_cand IN ITEMS
              "${_dir}/lib${_name}.a" "${_dir}/lib${_name}.dylib" "${_dir}/lib${_name}.dll.a")
            if(EXISTS "${_cand}")
              list(APPEND _pc_items "${_cand}")
            endif()
          endforeach()
        endforeach()
      endforeach()
      ptlib_link_is_windows(_pc_items _pc_win)
      if(NOT _pc_win)
        set(_pc_ok FALSE)
      endif()
      if(NOT _pc_ok)
        message(STATUS "PTLIB_${feature}: ignoring host pkg-config result; not a Windows library")
      endif()
    endif()
    if(_pc_ok)
      set(PTLIB_${feature}_FOUND TRUE)
      set(PTLIB_${feature}_LINK PkgConfig::PTLIB_PC_${feature})
      ptlib_note_snippet("pkg_check_modules(PTLIB_PC_${feature} REQUIRED IMPORTED_TARGET ${ARGN})")
    endif()
  endif()
  ptlib_require(${feature} PTLIB_${feature}_FOUND)
endmacro()

